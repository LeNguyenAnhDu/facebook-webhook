{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ClientId": "core-service"
  },
  "KafkaConsumer": {
    "GroupId": "core-service-raw-events"
  },
  "Automation": {
    "RateLimitPerMinute": 20,
    "RepeatSpamThreshold24Hours": 3
  },
  "AiClassification": {
    "Provider": "fallback",
    "Endpoint": "",
    "ApiKey": "",
    "Model": "",
    "TimeoutSeconds": 15,
    "FailureThreshold": 5,
    "BreakDurationSeconds": 30
  }
}
