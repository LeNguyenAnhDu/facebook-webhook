{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ClientId": "retry-service"
  },
  "KafkaConsumer": {
    "GroupId": "retry-service-send-failed"
  },
  "RetryProcessing": {
    "MaxRetries": 3,
    "BaseDelaySeconds": 1
  }
}
