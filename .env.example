# Shared
Kafka__BootstrapServers=localhost:9092
Database__ConnectionString=Host=localhost;Port=5432;Database=your_database;Username=your_user;Password=your_password
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/WITH/YOUR/WEBHOOK
POSTGRES_DB=your_database
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password

# FB.BackendAPI
DashboardAuth__AdminToken=change-me-admin-token
FacebookGraph__AppId=replace-with-app-id
FacebookGraph__DefaultPageId=replace-with-page-id
FacebookGraph__GraphVersion=v25.0
FacebookGraph__PageAccessToken=replace-with-page-access-token
FacebookGraph__TimeoutSeconds=30
KafkaConsumer__ReplyCommandsGroupId=backend-api-reply-commands
KafkaConsumer__SendRetryGroupId=backend-api-send-retry
CircuitBreaker__FailureThreshold=10
CircuitBreaker__BreakDurationSeconds=30

# FB.WebhookService
FacebookWebhook__VerifyToken=replace-with-facebook-verify-token
FacebookWebhook__AppSecret=replace-with-facebook-app-secret

# FB.CoreService
AiClassification__Provider=fallback
AiClassification__Endpoint=replace-with-ai-endpoint
AiClassification__ApiKey=replace-with-ai-api-key
AiClassification__Model=replace-with-ai-model
AiClassification__TimeoutSeconds=15
AiClassification__FailureThreshold=5
AiClassification__BreakDurationSeconds=30
Automation__RateLimitPerMinute=20
Automation__RepeatSpamThreshold24Hours=3

# FB.RetryService
RetryProcessing__MaxRetries=3
RetryProcessing__BaseDelaySeconds=1
